# Image Workbench defaults. Every option can be changed per backend group.

# The whole workbench: file-list action, context-menu entry, editor, saving.
options.imageWorkbench.enable = 1

# Editor tabs: adjust, finetune, filters, annotate, resize, watermark
options.imageWorkbench.tabs = adjust,finetune,filters,annotate,resize

# Named crop ratios, as Name=W:H pairs
# options.imageWorkbench.cropPresets = Story=9:16, Social=1:1, Wide=16:9

# AI generation through nr-llm; usage and cost are booked to this configuration.
options.imageWorkbench.ai.enable = 1
options.imageWorkbench.ai.configuration = image-workbench
options.imageWorkbench.ai.defaultSize = 1024x1024
